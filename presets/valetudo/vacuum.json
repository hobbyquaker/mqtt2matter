{
  "id": "valetudo/vacuum",
  "name": "Valetudo robot vacuum",
  "description": "A robot vacuum running Valetudo as a Matter robotic vacuum cleaner: run mode (Idle/Cleaning), operational state from StatusStateAttribute/status, start, pause, resume and return to the dock over BasicControlCapability, the battery. Bridged vacuums show in Google Home and Home Assistant; Apple Home and Alexa want a vacuum as a Matter node of its own.",
  "vendor": "Valetudo",
  "format": 1,
  "variables": {
    "prefix": {
      "label": "Topic prefix",
      "description": "Valetudo → Connectivity → MQTT → Topic prefix",
      "default": "valetudo"
    },
    "identifier": {
      "label": "Identifier",
      "description": "Valetudo → Connectivity → MQTT → Identifier (the robot's name in the topics)"
    },
    "name": {"label": "Name", "default": "%identifier%"}
  },
  "device": {
    "name": "%name%",
    "vendor": "Valetudo",
    "availability": {
      "topic": "%prefix%/%identifier%/$state",
      "template": "{{ 'online' if value == 'ready' else 'offline' }}"
    },
    "endpoints": [
      {
        "deviceTypes": ["RoboticVacuumCleaner", "PowerSource"],
        "features": {"PowerSource": ["Battery", "Rechargeable"]},
        "mappings": [
          {
            "attribute": "RvcRunMode.currentMode",
            "status": {
              "topic": "%prefix%/%identifier%/StatusStateAttribute/status",
              "map": {
                "cleaning": 1,
                "paused": 1,
                "moving": 1,
                "manual_control": 1,
                "returning": 0,
                "docked": 0,
                "idle": 0,
                "error": 0
              }
            },
            "command": {
              "topic": "%prefix%/%identifier%/BasicControlCapability/operation/set",
              "format": {"1": "START", "0": "HOME"}
            }
          },
          {
            "attribute": "RvcOperationalState.operationalState",
            "status": {
              "topic": "%prefix%/%identifier%/StatusStateAttribute/status",
              "map": {
                "cleaning": "Running",
                "moving": "Running",
                "manual_control": "Running",
                "paused": "Paused",
                "returning": "SeekingCharger",
                "docked": "Docked",
                "idle": "Stopped",
                "error": "Error"
              }
            }
          },
          {
            "invoke": "RvcOperationalState.pause",
            "command": {"topic": "%prefix%/%identifier%/BasicControlCapability/operation/set", "payload": "PAUSE"}
          },
          {
            "invoke": "RvcOperationalState.resume",
            "command": {"topic": "%prefix%/%identifier%/BasicControlCapability/operation/set", "payload": "START"}
          },
          {
            "invoke": "RvcOperationalState.goHome",
            "command": {"topic": "%prefix%/%identifier%/BasicControlCapability/operation/set", "payload": "HOME"}
          },
          {
            "attribute": "PowerSource.batPercentRemaining",
            "status": {
              "topic": "%prefix%/%identifier%/BatteryStateAttribute/level",
              "type": "number",
              "unit": "halfPercent"
            }
          },
          {
            "attribute": "PowerSource.batChargeState",
            "status": {
              "topic": "%prefix%/%identifier%/BatteryStateAttribute/status",
              "map": {
                "charging": "IsCharging",
                "charged": "IsAtFullCharge",
                "discharging": "IsNotCharging",
                "none": "Unknown"
              }
            }
          }
        ]
      }
    ]
  }
}
