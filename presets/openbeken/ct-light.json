{
  "id": "openbeken/ct-light",
  "name": "OpenBeken CT light",
  "description": "An OpenBeken CW/WW light: on/off and dimmer as the dimmer preset, the colour temperature (154–500 mireds) sent with led_temperature and kept locally (the topic list documents no report of it).",
  "vendor": "OpenBeken",
  "format": 1,
  "variables": {
    "client": {
      "label": "Client topic",
      "description": "OpenBeken → Config → MQTT → Client Topic (Base Topic): the first level of its topics"
    },
    "name": {"label": "Name", "default": "%client%"}
  },
  "device": {
    "name": "%name%",
    "vendor": "OpenBeken",
    "availability": {"topic": "%client%/connected", "online": "online", "offline": "offline"},
    "endpoints": [
      {
        "deviceTypes": ["ColorTemperatureLight"],
        "options": {"light": {"onCommandType": "first"}},
        "mappings": [
          {
            "attribute": "OnOff.onOff",
            "status": {
              "topic": "%client%/led_enableAll/get",
              "map": {"1": true, "0": false},
              "get": {"topic": "%client%/led_enableAll/get", "payload": ""}
            },
            "command": {"topic": "cmnd/%client%/led_enableAll", "format": {"true": "1", "false": "0"}}
          },
          {
            "attribute": "LevelControl.currentLevel",
            "status": {
              "topic": "%client%/led_dimmer/get",
              "template": "{{ value if value | float > 0 else '' }}",
              "type": "number",
              "unit": "percentLevel",
              "get": {"topic": "%client%/led_dimmer/get", "payload": ""}
            },
            "command": {"topic": "cmnd/%client%/led_dimmer", "unit": "percentLevel", "round": 0}
          },
          {
            "attribute": "ColorControl.colorTemperatureMireds",
            "command": {"topic": "cmnd/%client%/led_temperature", "round": 0, "optimistic": true}
          }
        ]
      }
    ]
  }
}
