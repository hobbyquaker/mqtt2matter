{
  "name": "mqtt2matter",
  "version": "0.3.1",
  "description": "Generic MQTT to Matter bridge: compose Matter devices by hand and map them onto MQTT topics with configurable payloads; importers for Zigbee2MQTT and Home Assistant MQTT discovery",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Sebastian Raff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/mqtt2matter.git"
  },
  "homepage": "https://github.com/hobbyquaker/mqtt2matter#readme",
  "bugs": {
    "url": "https://github.com/hobbyquaker/mqtt2matter/issues"
  },
  "keywords": [
    "matter",
    "matter.js",
    "mqtt",
    "bridge",
    "smarthome",
    "zigbee2mqtt",
    "home-assistant",
    "homekit",
    "alexa",
    "google-home"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mqtt2matter": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ui/dist",
    "docs",
    "example",
    "presets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./ui/tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "test:e2e": "playwright test --config ui/playwright.config.ts",
    "start": "node dist/main.js",
    "prepack": "npm run build",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@huggingface/jinja": "0.5.10",
    "@matter/main": "0.18.0",
    "mqtt": "^5.16.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "aedes": "^1.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
