{
  "name": "mqtt2matter",
  "version": "0.1.0",
  "private": true,
  "description": "Generic MQTT to Matter bridge: compose Matter devices by hand and map them onto MQTT topics with configurable payloads; importers for Zigbee2MQTT and Home Assistant MQTT discovery",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Sebastian Raff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/mqtt2matter.git"
  },
  "homepage": "https://github.com/hobbyquaker/mqtt2matter#readme",
  "bugs": {
    "url": "https://github.com/hobbyquaker/mqtt2matter/issues"
  },
  "keywords": [
    "matter",
    "matter.js",
    "mqtt",
    "bridge",
    "smarthome",
    "zigbee2mqtt",
    "home-assistant",
    "homekit",
    "alexa",
    "google-home"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mqtt2matter": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "start": "node dist/main.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@matter/main": "0.18.0",
    "mqtt": "^5.16.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "aedes": "^1.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
